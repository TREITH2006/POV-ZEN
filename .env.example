# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# Local dev default is SQLite; swap to a PostgreSQL URL in production.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --- Auth / Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256
# "strict" (default, recommended) requires the frontend and API to be
# same-site in production — e.g. app.example.com + api.example.com (two
# subdomains of one domain count as same-site; totally unrelated domains do
# not). If they genuinely cannot be same-site, set this to "none" — the
# cookie is then automatically forced Secure (HTTPS-only), and you lose
# SameSite's built-in CSRF protection, so add your own CSRF mitigation.
COOKIE_SAMESITE=strict

# --- CORS ---
# Comma-separated list of allowed frontend origins. In production this must
# be your real deployed frontend origin(s) (https://...), not localhost.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- File storage ---
# "local" for development. A future cloud storage backend can be added
# without changing application code (see backend/services/storage_service.py).
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# --- Environment ---
ENVIRONMENT=development
