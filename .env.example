# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# Local dev default is SQLite; swap to a PostgreSQL URL in production.
DATABASE_URL=sqlite:///./pov_zen.db

# --- Auth / Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- File storage ---
# "local" for development. A future cloud storage backend can be added
# without changing application code (see backend/services/storage_service.py).
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# --- Environment ---
ENVIRONMENT=development
